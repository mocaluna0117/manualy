# 実際の値は .env に書く(Git管理外)。このファイルは「必要な変数の一覧」なので
# パスワード等の実値は絶対に書かないこと。
# 生成例: openssl rand -hex 24

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=manual_search
POSTGRES_PORT=54321

# --- MinIO (ローカルS3) ---
MINIO_ROOT_USER=   # 例: manual_minio_xxxx (任意の値)
MINIO_ROOT_PASSWORD=   # openssl rand -hex 24 などで生成した値を入れる
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_BUCKET=manuals

# --- AWS / Cognito (composeのappプロファイル用) ---
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# --- RAGサービスの共有トークン(backendとragで同じ値を設定) ---
RAG_API_TOKEN=   # openssl rand -hex 32 で生成
