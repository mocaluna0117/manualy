# --- Prisma / PostgreSQL ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:54321/manual_search?schema=public"

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- S3 (ローカルはMinIO / 本番はAmazon S3) ---
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=manuals
S3_FORCE_PATH_STYLE=true

# --- RAGサービス(Python/FastAPI) ---
RAG_SERVICE_URL=http://localhost:8000

# --- Cognito認証 ---
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
S3_PUBLIC_ENDPOINT= # コンテナ環境でブラウザから見えるMinIOのURL(例 http://localhost:59000)。S3では空
