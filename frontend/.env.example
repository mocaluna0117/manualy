VITE_GRAPHQL_URL=http://localhost:3000/graphql
# Cognito User Poolの発行者URL(https://cognito-idp.<region>.amazonaws.com/<userPoolId>)
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
# Hosted UIのドメイン(https://xxx.auth.<region>.amazoncognito.com)
VITE_COGNITO_DOMAIN=

# ---- 認証方式の切り替え ----
# 'cognito'(既定) か 'supabase'。未設定ならcognito(いまの本番)
VITE_AUTH_PROVIDER=cognito
# Supabase Auth。publishable(anon)キーだけ。service_roleは絶対に置かない
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
