# 本番ビルド(npm run build)で使う値。Viteが .env より優先して読む。
#
# ここに秘密は無い。VITE_で始まる値は全部フロントのJSに埋め込まれて
# 公開されるので、秘密を置いてはいけない。だからGitにも入れてある
# (ローカルの.envだけに置いていた結果、localhost向けのビルドを本番へ
#  上げてしまい、全部の通信がERR_CONNECTION_REFUSEDになった)。
#
# CloudFrontがフロントとAPIを同じオリジンにまとめているので、
# GraphQLの宛先は相対パスでよい(CORSも発生しない)。
VITE_GRAPHQL_URL=/graphql
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_FNDNz0jSk
VITE_COGNITO_CLIENT_ID=7lnm9n6l4rmnb5qol93ujiagi2
VITE_COGNITO_DOMAIN=https://manual-search-mokuson.auth.ap-northeast-1.amazoncognito.com

# ---- 認証方式の切り替え ----
# 'cognito'(既定) か 'supabase'。**未設定ならcognito**。
# 「Supabaseの値が入っていればSupabase」のような自動判定にはしていない。
# このファイルはAWSのDockerfileにもCOPYされるので、値を書き足しただけで
# 本番のログインが切り替わってしまうと、切り替え日まで誰も入れなくなる。
#
# 2026-09-16(水) 09:00 の切り替えでも、**このファイルは書き換えない。**
# ここは cognito のまま、VITE_GRAPHQL_URL も /graphql のままにしておく。
#
# 理由: 上のとおりAWS向けのビルド(scripts/deploy-frontend.sh)がこの値を焼き込む。
# supabase や Cloud Run のURLに書き換えてコミットすると、**切り戻し先のCloudFrontが
# 新環境向けの値で潰れ**、移行がうまくいかなかったときに戻る場所が無くなる。
#
# 新環境(Cloudflare Pages)側は scripts/deploy-pages.sh が、ビルド時の環境変数で
# VITE_AUTH_PROVIDER=supabase と VITE_GRAPHQL_URL=<Cloud RunのURL>/graphql を渡す。
# Vite は .env の値より実際の環境変数を優先するので、ここに書き足す必要は無い。
VITE_AUTH_PROVIDER=cognito

# Supabase Auth。publishable(anon)キーだけを置く。
# VITE_で始まる値は公開JSに埋め込まれるので、service_roleは絶対に置かない
VITE_SUPABASE_URL=https://xscltxkkphwguetlcbkk.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_6RSq4c1Cdwu7el1E5Gu8kw_U9gQIXny
