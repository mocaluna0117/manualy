{
  "family": "manual-search-backend",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::271357390238:role/manual-search-ecs-execution",
  "taskRoleArn": "arn:aws:iam::271357390238:role/manual-search-backend-task",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "271357390238.dkr.ecr.ap-northeast-1.amazonaws.com/manual-search/backend:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "RAG_SERVICE_URL", "value": "http://rag:8000" },
        { "name": "S3_REGION", "value": "ap-northeast-1" },
        { "name": "S3_BUCKET", "value": "manual-search-manuals-271357390238" },
        { "name": "COGNITO_REGION", "value": "ap-northeast-1" },
        { "name": "COGNITO_USER_POOL_ID", "value": "ap-northeast-1_FNDNz0jSk" },
        { "name": "COGNITO_CLIENT_ID", "value": "7lnm9n6l4rmnb5qol93ujiagi2" },
        {
          "name": "FRONTEND_ORIGIN",
          "value": "https://d3r3bcg6d6aepn.cloudfront.net"
        },
        { "name": "DATABASE_SSL_CA", "value": "/app/certs/rds-ca.pem" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:271357390238:secret:manual-search/app-psapvh:DATABASE_URL::"
        },
        {
          "name": "RAG_API_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:271357390238:secret:manual-search/app-psapvh:RAG_API_TOKEN::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/manual-search/backend",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
