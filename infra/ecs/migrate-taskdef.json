{
  "family": "manual-search-migrate",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::271357390238:role/manual-search-ecs-execution",
  "containerDefinitions": [
    {
      "name": "migrate",
      "image": "271357390238.dkr.ecr.ap-northeast-1.amazonaws.com/manual-search/backend:migrate",
      "essential": true,
      "command": ["npx", "prisma", "migrate", "deploy"],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:271357390238:secret:manual-search/app-psapvh:DATABASE_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/manual-search/backend",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "migrate"
        }
      }
    }
  ]
}
